# Harbor Scanner Grype settings.
# Copy to .env (./deploy.sh does it on first run), edit, then apply with:
#   docker compose up -d        (or ./deploy.sh)
# .env is not committed: it holds the API key and registry credentials.

# ---------------------------------------------------------------------------
# Container
# ---------------------------------------------------------------------------
# Time zone for the DB update schedule and log timestamps, e.g. Europe/Moscow
TZ=UTC
# Host port for the adapter API (Harbor can also reach it as http://grype-adapter:8090)
SCANNER_HOST_PORT=8090
# error | warn | info | debug
SCANNER_LOG_LEVEL=info
# text: readable key=value lines with a timestamp; json: one JSON object per line (log collectors)
SCANNER_LOG_FORMAT=text
# Memory for the scan queue and the finished reports, which are kept in memory only. When the
# limit is reached, finished reports are evicted first; queued jobs never are.
SCANNER_REDIS_MAXMEMORY=1gb

# ---------------------------------------------------------------------------
# Vulnerability database
# ---------------------------------------------------------------------------
# Scans never download the database: it is updated only by cron on this schedule (in TZ).
GRYPE_DB_UPDATE_SCHEDULE=0 0 * * *
# Scans fail when the database is older than this, so the nightly update must succeed
# at least this often.
GRYPE_DB_MAX_ALLOWED_BUILT_AGE=120h

# ---------------------------------------------------------------------------
# Registry access
# ---------------------------------------------------------------------------
# Account used when Harbor sends no credentials or a Bearer token, and only for the registry
# hosts listed in SCANNER_REGISTRY_TRUSTED_HOSTS (host names from Harbor's scan request).
# Use a Harbor robot account with pull permission, never admin. Empty: only what Harbor sends.
SCANNER_REGISTRY_USERNAME=
SCANNER_REGISTRY_PASSWORD=
SCANNER_REGISTRY_TRUSTED_HOSTS=

# Registry host from Harbor's scan request -> host[:port] the scanner connects to instead.
# Comma-separated host=target pairs; a target without a port keeps the original port.
SCANNER_REGISTRY_HOST_MAP=localhost=nginx:8080,harbor.corp.local=harbor.corp.local:443

# Names the container cannot resolve via DNS, added to its /etc/hosts.
# Comma-separated host=ip pairs, e.g. harbor.corp.local=192.168.6.131
SCANNER_EXTRA_HOSTS=

# TLS towards the registry. Off by default, as in the deployed image: with certificate checks
# off, anyone on the network who can answer for a trusted host name receives the registry
# credentials. To turn verification on: mount your CA into the container, point SSL_CERT_FILE
# (a file) or SSL_CERT_DIR (a directory) at it, and set SCANNER_REGISTRY_INSECURE_SKIP_TLS_VERIFY=false.
SCANNER_REGISTRY_INSECURE_USE_HTTP=true
SCANNER_REGISTRY_INSECURE_SKIP_TLS_VERIFY=true

# ---------------------------------------------------------------------------
# Access to the adapter API
# ---------------------------------------------------------------------------
# Required. Harbor sends it with every request: in Harbor > Interrogation Services > Scanners,
# set Authorization to "Bearer" (or "API Key") and paste the same value.
# Generate one with: openssl rand -hex 32 (must be at least 16 characters).
SCANNER_API_KEY=

# ---------------------------------------------------------------------------
# Scanning
# ---------------------------------------------------------------------------
# A scan running longer is stopped and reported to Harbor as failed
SCANNER_GRYPE_TIMEOUT=15m
# Parallel scans. Harbor runs one scan per jobservice worker, so values above Harbor's
# max_job_workers (harbor.yml) add nothing. Each scan needs RAM and /tmp space for
# the image being scanned.
SCANNER_JOB_QUEUE_WORKER_CONCURRENCY=5

# ---------------------------------------------------------------------------
# Severity shown in Harbor
# ---------------------------------------------------------------------------
# SCANNER_POLICY_* and SCANNER_EXPLOITDB_MAX_AGE must not be set to an empty value: an empty
# value stops the start. To use the default shown below, delete the line instead of blanking it.
# false: use Grype's own severity and ignore everything below
SCANNER_RISK_ENABLED=true
# policy:  five rules, the reason is written in front of the description (see RISK_CALCULATION.md)
#          1 CISA KEV -> Critical; 2 malicious package (GitHub "Malware in", CWE-506) -> Critical;
#          3 grype risk: from SCANNER_POLICY_CRITICAL Critical, from _HIGH High, from _MEDIUM Medium, else Low;
#          4 no EPSS -> Grype's severity, at most High; 5 public exploit raises to High (network, High/Critical)
#          or at least Medium
# formula: Risk% = EPSS*100 * CVSS/10, compared with SCANNER_RISK_CRITICAL..LOW (percent)
# cvss:    CVSS base score, compared with SCANNER_RISK_CVSS_CRITICAL..LOW
SCANNER_RISK_MODE=policy
SCANNER_POLICY_CRITICAL=70
SCANNER_POLICY_HIGH=30
SCANNER_POLICY_MEDIUM=10
# Exploit-DB list for rule 5, downloaded by the nightly job after the vulnerability DB (honours HTTPS_PROXY)
SCANNER_EXPLOITDB_URL=https://gitlab.com/exploit-database/exploitdb/-/raw/main/files_exploits.csv
SCANNER_EXPLOITDB_MAX_AGE=336h
# formula and cvss modes only
SCANNER_RISK_CRITICAL=85
SCANNER_RISK_HIGH=70
SCANNER_RISK_MEDIUM=50
SCANNER_RISK_LOW=0.01
SCANNER_RISK_CVSS_CRITICAL=9.0
SCANNER_RISK_CVSS_HIGH=7.0
SCANNER_RISK_CVSS_MEDIUM=4.0
SCANNER_RISK_CVSS_LOW=0.1
# Used when a vulnerability has no EPSS / CVSS data (formula mode)
SCANNER_RISK_DEFAULT_EPSS=0.1
SCANNER_RISK_DEFAULT_CVSS=5.0
